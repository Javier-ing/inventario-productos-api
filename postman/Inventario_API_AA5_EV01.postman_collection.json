        {
            "name": "00 Estado del servicio",
            "item": [
                {
                    "name": "GET /api - estado del servicio",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Estado HTTP 200', () => pm.response.to.have.status(200));",
                                    "pm.test('Servicio activo y base conectada', () => {",
                                    "    const cuerpo = pm.response.json();",
                                    "    pm.expect(cuerpo.estado).to.eql('activo');",
                                    "    pm.expect(cuerpo.baseDatos).to.eql('conectada');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api"
                            ]
                        },
                        "description": ""
                    }
                }
            ]
        },
        {
            "name": "01 Registrar productos",
            "item": [
                {
                    "name": "POST registrar producto (201)",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const sufijo = String(Date.now()).slice(-8);",
                                    "pm.collectionVariables.set('codigo1', 'PM-' + sufijo + 'A');",
                                    "pm.collectionVariables.set('codigo1Minuscula', 'pm-' + sufijo + 'a');",
                                    "pm.collectionVariables.set('codigo2', 'PM-' + sufijo + 'B');"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Estado HTTP 201', () => pm.response.to.have.status(201));",
                                    "const producto = pm.response.json();",
                                    "pm.test('Devuelve idProducto y fechaRegistro generados por el servidor', () => {",
                                    "    pm.expect(producto.idProducto).to.match(/^[a-f0-9]{24}$/);",
                                    "    pm.expect(producto.fechaRegistro).to.be.a('string');",
                                    "});",
                                    "pm.test('Encabezado Location apunta al nuevo recurso', () => {",
                                    "    pm.expect(pm.response.headers.get('Location')).to.eql('/api/productos/' + producto.idProducto);",
                                    "});",
                                    "pm.collectionVariables.set('idProducto1', producto.idProducto);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/productos",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "productos"
                            ]
                        },
                        "description": "",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"codigo\": \"{{codigo1}}\",\n    \"nombre\": \"Webcam HD\",\n    \"descripcion\": \"Cámara web 1080p\",\n    \"precio\": 125000,\n    \"stock\": 15\n}",
                            "options": {

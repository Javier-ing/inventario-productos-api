# Copie este archivo como .env y ajuste los valores (el archivo .env NO se sube a GitHub).

# Puerto donde escucha la API.
PORT=8080

# Cadena de conexión a MongoDB.
# Local:  mongodb://127.0.0.1:27017/inventario_db
# Atlas:  mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/inventario_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/inventario_db

# Base de datos EXCLUSIVA para las pruebas automáticas (el nombre debe terminar en _test porque se borra).
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/inventario_test

# Orígenes permitidos por CORS (separados por coma). El frontend de Vite usa el 5173.
CORS_ORIGIN=http://localhost:5173
